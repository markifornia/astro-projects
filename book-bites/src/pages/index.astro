---
import Layout from '../layouts/Layout.astro';

const getUser = () => {
	return Math.random() < 0.5 ? null : {
		name: 'Mark',
		email: 'mark@bookbites.com'
	}
}

const user = getUser();
---

<Layout>
	<div class="content">
		{user && (
		<h2>Welcome, {user.name}</h2>
		<p>Logged in as {user.email}</p>
		)}
		<p>Lorem ipsum</p>
		<a href="/books">Take a look at my reviews</a>
	</div>
</Layout>

<style is:global>
	.content {
		text-align: center;
	}

	a {
		display: inline-block;
		background-color: #7a49c5;
		color: #ffffff;
		padding: 6px 10px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;
	}

	a:hover {
		background-color: #965ee9;
	}
</style>